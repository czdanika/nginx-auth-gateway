# Strava API credentials
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REFRESH_TOKEN=your_refresh_token

# Login credentials
# Format: username:password  (or username:password:backend_host:backend_port for multi-user)
# Multiple users: alice:Password1,bob:Password2:app-bob:8080
USERS=yourname:YourPassword

# Cookie signing secret – generate with: openssl rand -hex 32
COOKIE_SECRET=change-this-to-a-long-random-string

# Session length in days
COOKIE_DAYS=30

# Login page language: en | hu  (default: en)
LANGUAGE=en
